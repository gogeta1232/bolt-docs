# Bolt Docs — environment variables
# Copy to .env.local if you need overrides. No secrets here — all values are safe to commit.

# Discord invite — permissions 1101017476118 = full moderation set
# Generate from https://discord.com/developers/applications -> OAuth2 -> URL Generator
VITE_DISCORD_INVITE_URL=https://discord.com/api/oauth2/authorize?client_id=1424440972758220800&permissions=1101017476118&scope=bot%20applications.commands

# GitHub links (used for Topbar + footer)
VITE_GITHUB_URL=https://github.com/gogeta1232/Bolt
VITE_GITHUB_DOCS_URL=https://github.com/gogeta1232/bolt-docs

# Live docs URL (shown in Bolt-OS README)
VITE_SITE_URL=https://boltdocs.vercel.app
